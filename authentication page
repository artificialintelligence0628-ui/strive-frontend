  <div class="right-panel">

    <!-- Watermark icon -->
    <div class="right-panel-bg-icon">
      <svg width="280" height="280" viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="50" fill="#7bbfea"/>
        <rect x="46" y="14" width="7" height="30" rx="3.5" fill="white" transform="rotate(0,50,50)"/>
