          <label>Your email address</label>
          <input type="email" id="forgot-email" placeholder="you@university.edu.gh">
        </div>
        <button class="submit-btn" onclick="sendReset()" id="forgot-btn">
          <div class="spinner"></div>
          <span class="btn-text">Send reset link →</span>
