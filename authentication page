<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STRIVE — Sign In</title>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; }
body {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
  background: #f5f5f0;
  color: #1a1a1a;
  min-height: 100vh;
  display: flex;
  align-items: stretch;
}

/* ── LAYOUT ── */
.auth-layout {
  display: flex;
  width: 100%;
  min-height: 100vh;
}

/* ── LEFT PANEL ── */
.left-panel {
  width: 480px;
  flex-shrink: 0;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 48px 52px;
  position: relative;
  overflow: hidden;
}

.left-panel::before {
  content: '';
  position: absolute;
  top: -120px; left: -120px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(123,191,234,0.18) 0%, transparent 70%);
  pointer-events: none;
}
.left-panel::after {
  content: '';
  position: absolute;
  bottom: -80px; right: -80px;
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(123,191,234,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.left-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  animation: fadeUp 0.6s ease both;
}
.left-logo-text {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: white;
}

.left-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28px;
  animation: fadeUp 0.6s 0.1s ease both;
}
.left-tagline {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: white;
  line-height: 1.1;
}
.left-tagline .hl {
  color: #7bbfea;
}
.left-desc {
  font-size: 15px;
  color: #888;
  line-height: 1.7;
  max-width: 340px;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 8px;
}
.feature-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  color: #aaa;
}
.feature-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #7bbfea;
  flex-shrink: 0;
}

.left-footer {
  font-size: 11px;
  color: #555;
  animation: fadeUp 0.6s 0.2s ease both;
}

/* ── RIGHT PANEL ── */
.right-panel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 32px;
  background: #f5f5f0;
}

.auth-card {
  width: 100%;
  max-width: 420px;
  animation: fadeUp 0.5s 0.15s ease both;
}

.auth-card-header {
  margin-bottom: 32px;
}
.auth-card-title {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #1a1a1a;
  margin-bottom: 6px;
}
.auth-card-sub {
  font-size: 14px;
  color: #888;
}

/* TABS */
.auth-tabs {
  display: flex;
  background: #efefeb;
  border-radius: 10px;
  padding: 4px;
  margin-bottom: 28px;
  gap: 4px;
}
.auth-tab {
  flex: 1;
  padding: 9px;
  border-radius: 7px;
  border: none;
  background: transparent;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  color: #888;
  cursor: pointer;
  transition: all 0.18s;
}
.auth-tab.active {
  background: white;
  color: #1a1a1a;
  box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}

/* FORM */
.auth-form { display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field-row { display: flex; gap: 12px; }
.field-row .field { flex: 1; }
.field label {
  font-size: 12px;
  font-weight: 600;
  color: #555;
  letter-spacing: 0.02em;
}
.field input {
  padding: 11px 14px;
  border: 1.5px solid #e0e0d8;
  border-radius: 10px;
  font-family: inherit;
  font-size: 14px;
  color: #1a1a1a;
  background: white;
  transition: border-color 0.18s, box-shadow 0.18s;
  outline: none;
  width: 100%;
}
.field input:focus {
  border-color: #7bbfea;
  box-shadow: 0 0 0 3px rgba(123,191,234,0.15);
}
.field input::placeholder { color: #c0c0b8; }

.field-hint {
  font-size: 11px;
  color: #aaa;
  margin-top: 2px;
}

.forgot-link {
  font-size: 12px;
  color: #7bbfea;
  text-decoration: none;
  font-weight: 600;
  align-self: flex-end;
  margin-top: -8px;
  transition: color 0.15s;
}
.forgot-link:hover { color: #4a9fd4; }

.submit-btn {
  padding: 13px;
  background: #1a1a1a;
  color: white;
  border: none;
  border-radius: 10px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.18s;
  letter-spacing: -0.01em;
  margin-top: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.submit-btn:hover { background: #333; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
.submit-btn:active { transform: translateY(0); }
.submit-btn.loading { opacity: 0.7; pointer-events: none; }

.spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  display: none;
}
.submit-btn.loading .spinner { display: block; }
.submit-btn.loading .btn-text { display: none; }

/* DIVIDER */
.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 4px 0;
  color: #ccc;
  font-size: 12px;
}
.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #e0e0d8;
}

/* GOOGLE BTN */
.google-btn {
  padding: 11px;
  background: white;
  border: 1.5px solid #e0e0d8;
  border-radius: 10px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  cursor: pointer;
  transition: all 0.18s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.google-btn:hover { border-color: #bbb; background: #fafafa; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

/* PASSWORD STRENGTH */
.strength-bar {
  height: 3px;
  background: #e0e0d8;
  border-radius: 2px;
  margin-top: 6px;
  overflow: hidden;
}
.strength-fill {
  height: 100%;
  border-radius: 2px;
  width: 0%;
  transition: width 0.3s, background 0.3s;
}
.strength-text {
  font-size: 11px;
  color: #aaa;
  margin-top: 4px;
}

/* TERMS */
.terms-text {
  font-size: 11px;
  color: #aaa;
  text-align: center;
  line-height: 1.6;
  margin-top: 4px;
}
.terms-text a { color: #7bbfea; text-decoration: none; }

/* ERROR/SUCCESS */
.alert {
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  display: none;
}
.alert.error { background: #fff5f5; border: 1px solid #ffc9c9; color: #c92a2a; }
.alert.success { background: #f5fdf7; border: 1px solid #b8e8c8; color: #2e7d32; }
.alert.show { display: block; }

/* PANELS */
.form-panel { display: none; }
.form-panel.active { display: flex; flex-direction: column; gap: 16px; }

/* ANIMATIONS */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ICON IN RIGHT PANEL */
.card-icon-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}
.card-icon-pulse {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-icon-pulse::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  background: rgba(123,191,234,0.12);
  animation: iconPulse 2.5s ease-in-out infinite;
}
@keyframes iconPulse {
  0%,100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.12); opacity: 0.7; }
}
.card-icon-label {
  font-size: 13px;
  font-weight: 700;
  color: #7bbfea;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* BLUE ACCENT TOP BAR */
.right-panel {
  position: relative;
}
.right-panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, transparent, #7bbfea 40%, #4a9fd4 70%, transparent);
}

/* BLUE SUBMIT BUTTON */
.submit-btn {
  background: #7bbfea !important;
}
.submit-btn:hover {
  background: #5aade0 !important;
  box-shadow: 0 4px 20px rgba(123,191,234,0.35) !important;
}

/* ACTIVE TAB with blue underline */
.auth-tab.active {
  color: #1a1a1a;
  position: relative;
}
.auth-tab.active::after {
  content: '';
  position: absolute;
  bottom: 2px; left: 50%;
  transform: translateX(-50%);
  width: 18px; height: 2px;
  background: #7bbfea;
  border-radius: 2px;
}

/* BLUE INPUT LABEL accent on focus */
.field:focus-within label {
  color: #4a9fd4;
}

/* DECORATIVE icon watermark behind card */
.right-panel-bg-icon {
  position: absolute;
  bottom: 32px;
  right: 32px;
  opacity: 0.04;
  pointer-events: none;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .left-panel { display: none; }
  .right-panel { padding: 32px 20px; }
}
</style>
</head>
