        <rect x="46" y="14" width="5" height="22" rx="2.5" fill="white" opacity=".68" transform="rotate(66,50,50)"/>
        <rect x="46" y="14" width="4" height="17" rx="2" fill="white" opacity=".52" transform="rotate(88,50,50)"/>
        <rect x="46" y="14" width="3" height="12" rx="1.5" fill="white" opacity=".36" transform="rotate(110,50,50)"/>
        <rect x="46" y="14" width="7" height="30" rx="3.5" fill="white" transform="rotate(-22,50,50)"/>
        <rect x="46" y="14" width="6.5" height="28" rx="3.25" fill="white" opacity=".9" transform="rotate(-44,50,50)"/>
        <rect x="46" y="14" width="6" height="26" rx="3" fill="white" opacity=".82" transform="rotate(-66,50,50)"/>
        <rect x="46" y="14" width="5" height="22" rx="2.5" fill="white" opacity=".68" transform="rotate(-88,50,50)"/>
        <rect x="46" y="14" width="4" height="17" rx="2" fill="white" opacity=".52" transform="rotate(-110,50,50)"/>
      </svg>
    </div>

    <div class="auth-card">

      <!-- Icon row -->
      <div class="card-icon-row">
        <div class="card-icon-pulse">
          <svg width="36" height="36" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="50" fill="#7bbfea"/>
            <rect x="46" y="14" width="7" height="30" rx="3.5" fill="white" transform="rotate(0,50,50)"/>
            <rect x="46" y="14" width="6.5" height="28" rx="3.25" fill="white" opacity=".9" transform="rotate(22,50,50)"/>
