<script>
let currentMode = 'signin';

function switchMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.auth-tab').forEach((t,i) => {
    t.classList.toggle('active', (mode === 'signin' && i === 0) || (mode === 'signup' && i === 1));
  });
  document.querySelectorAll('.form-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('panel-' + (mode === 'forgot' ? 'forgot' : mode)).classList.add('active');
  hideAlert();

  if (mode === 'signin') {
    document.getElementById('card-title').textContent = 'Welcome back';
    document.getElementById('card-sub').textContent = 'Sign in to continue learning with STRIVE';
  } else if (mode === 'signup') {
    document.getElementById('card-title').textContent = 'Start learning smarter';
    document.getElementById('card-sub').textContent = 'Create your free STRIVE account today';
  } else {
    document.getElementById('card-title').textContent = 'Reset password';
    document.getElementById('card-sub').textContent = "We'll send a reset link to your email";
  }
}

function showForgot(e) {
  e.preventDefault();
  switchMode('forgot');
}

function showAlert(msg, type) {
  const el = document.getElementById('alert');
  el.textContent = msg;
  el.className = 'alert ' + type + ' show';
}
function hideAlert() {
  document.getElementById('alert').className = 'alert';
}

function setLoading(btnId, loading) {
  const btn = document.getElementById(btnId);
  btn.classList.toggle('loading', loading);
}

function signIn() {
  hideAlert();
  const email = document.getElementById('signin-email').value.trim();
  const password = document.getElementById('signin-password').value;
  if (!email) { showAlert('Please enter your email address.', 'error'); return; }
  if (!password) { showAlert('Please enter your password.', 'error'); return; }
  if (!email.includes('@')) { showAlert('Please enter a valid email address.', 'error'); return; }

  setLoading('signin-btn', true);
  // Simulate auth — replace with your real backend call
  setTimeout(() => {
    setLoading('signin-btn', false);
    // On success → redirect to main app
    showAlert('✓ Signed in! Redirecting to STRIVE...', 'success');
    setTimeout(() => {
      // window.location.href = 'strive-clean.html';
      showAlert('✓ Demo: in a real app this redirects to strive-clean.html', 'success');
    }, 1000);
  }, 1400);
}

function signUp() {
  hideAlert();
  const first = document.getElementById('signup-firstname').value.trim();
  const last = document.getElementById('signup-lastname').value.trim();
  const email = document.getElementById('signup-email').value.trim();
  const password = document.getElementById('signup-password').value;

  if (!first || !last) { showAlert('Please enter your full name.', 'error'); return; }
  if (!email || !email.includes('@')) { showAlert('Please enter a valid email address.', 'error'); return; }
  if (password.length < 8) { showAlert('Password must be at least 8 characters.', 'error'); return; }

  setLoading('signup-btn', true);
  setTimeout(() => {
    setLoading('signup-btn', false);
    showAlert('✓ Account created! Welcome to STRIVE, ' + first + '!', 'success');
    setTimeout(() => {
      // window.location.href = 'strive-clean.html';
      showAlert('✓ Demo: in a real app this redirects to strive-clean.html', 'success');
    }, 1000);
  }, 1600);
}

function sendReset() {
  hideAlert();
  const email = document.getElementById('forgot-email').value.trim();
  if (!email || !email.includes('@')) { showAlert('Please enter a valid email address.', 'error'); return; }
  setLoading('forgot-btn', true);
  setTimeout(() => {
    setLoading('forgot-btn', false);
    showAlert('✓ Reset link sent to ' + email + '. Check your inbox.', 'success');
  }, 1200);
}

function googleAuth() {
  showAlert('Google sign-in: connect your OAuth provider in the backend.', 'error');
}

function checkStrength(val) {
  const fill = document.getElementById('strength-fill');
  const text = document.getElementById('strength-text');
  let score = 0;
  if (val.length >= 8) score++;
  if (val.length >= 12) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;

  const levels = [
    { w:'0%', bg:'#e0e0d8', t:'Enter a password' },
    { w:'25%', bg:'#f44336', t:'Weak' },
    { w:'50%', bg:'#ff9800', t:'Fair' },
    { w:'75%', bg:'#ffc107', t:'Good' },
    { w:'100%', bg:'#4caf50', t:'Strong 💪' },
  ];
  const level = val.length === 0 ? 0 : Math.min(score, 4);
  fill.style.width = levels[level].w;
  fill.style.background = levels[level].bg;
  text.textContent = levels[level].t;
  text.style.color = level === 0 ? '#aaa' : levels[level].bg;
}
